{
  "name": "agentos",
  "version": "0.1.0",
  "description": "Linear-native agent task orchestration system",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "aos": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "chaos:check": "tsx src/chaos/run-fixtures.ts",
    "lint": "eslint src/"
  },
  "author": "Zhiyuan Wang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzhiyuann/agentos.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@linear/sdk": "^78.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.205.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.0"
  }
}
