# AgentOS Configuration
# Copy to .env and fill in real values (the wizard can also generate .env for you).

# ──── Required ────

# Linear team integration
AOS_LINEAR_TEAM_ID=your-linear-team-uuid
AOS_LINEAR_TEAM_KEY=YOUR

# Execution host ("localhost" for single-machine setup)
AOS_HOST=localhost
AOS_USER=your-username

# Organization context (used in agent prompts + Discord messages)
AOS_ORG_NAME=Your Company

# ──── Optional ────

# Base directory for agent workspaces
AOS_WORKSPACE_BASE=~/agent-workspaces

# Monitor loop polling interval in ms
AOS_POLL_INTERVAL_MS=30000

# Webhook signature verification (recommended for production).
# Get this from Linear: Settings > API > OAuth Apps > Webhook secret.
AOS_WEBHOOK_SECRET=

# Source control org, shown to agents for repo context
AOS_SOURCE_CONTROL=github.com/your-org

# Telegram bot mention prefix (e.g. "myorg_" matches @myorg_cto)
AOS_TELEGRAM_BOT_PREFIX=

# Discord notifications (optional — enables completion summaries)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ──── Tuning (advanced) ────
# These defaults have been load-tested in production (RYA-206/207, RYA-601).
# Override only if you know what you're changing.

# Idle session dismissal — how long an agent can sit at the prompt before the
# Linear AgentSession is dismissed (tmux stays alive). Default: 300000 (5 min).
# Too low → agents look "done" while still thinking.
# Too high → "Working" indicator sticks around forever after real completion.
# AOS_IDLE_DISMISS_MS=300000

# Warmup grace period — newly spawned sessions get this long to load CLAUDE.md,
# read context, and plan before idle/rate-limit checks kick in. Default: 120000 (2 min).
# AOS_WARMUP_GRACE_MS=120000

# Follow-up idle dismissal — follow-up conversations finish fast, so they
# shouldn't show "Working" for 5 min after replying. Default: 60000 (1 min).
# AOS_FOLLOW_UP_IDLE_DISMISS_MS=60000
