{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryanhub.dev/breakdown-protocol/v0.1/repair-turn.schema.json",
  "title": "Breakdown Protocol Repair-Turn Payload (v0.1)",
  "description": "JSON schema for the structured payload an orchestrator emits when a breakdown is detected. Cognitive types (drift, ambiguity, dead_loop, misalignment, context_collapse) require repair_directive. Substrate types (infrastructure_failure, tool_error) MUST set repair_directive to null and route to the substrate path (see spec §4.4).",
  "type": "object",
  "required": ["breakdown"],
  "additionalProperties": false,
  "properties": {
    "breakdown": {
      "type": "object",
      "required": [
        "type",
        "detected_at",
        "evidence",
        "session_id",
        "trace_id",
        "span_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "drift",
            "ambiguity",
            "dead_loop",
            "misalignment",
            "context_collapse",
            "infrastructure_failure",
            "tool_error"
          ]
        },
        "subtype": {
          "type": ["string", "null"],
          "enum": [
            null,
            "dead_loop.in_session",
            "dead_loop.cross_session",
            "context_collapse.within_conversation",
            "context_collapse.substrate_state_loss",
            "context_collapse.stale_durable_state"
          ]
        },
        "detected_at": {
          "type": "string",
          "format": "date-time",
          "description": "RFC3339 wall-clock of detection."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "evidence": {
          "type": "object",
          "required": ["summary"],
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 200
            },
            "turn_refs": {
              "type": "array",
              "items": {"type": "string"}
            },
            "signals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value"],
                "properties": {
                  "name": {"type": "string"},
                  "value": {},
                  "threshold": {}
                },
                "additionalProperties": true
              }
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "weight"],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "drift",
                      "ambiguity",
                      "dead_loop",
                      "misalignment",
                      "context_collapse",
                      "infrastructure_failure",
                      "tool_error"
                    ]
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0
                  }
                }
              }
            }
          }
        },
        "repair_directive": {
          "oneOf": [
            {
              "type": "object",
              "required": ["class", "instruction"],
              "additionalProperties": false,
              "properties": {
                "class": {
                  "type": "string",
                  "enum": [
                    "reorient",
                    "clarify",
                    "break_loop",
                    "realign",
                    "reground",
                    "custom"
                  ]
                },
                "instruction": {
                  "type": "string",
                  "maxLength": 2000
                },
                "constraints": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "preserved_state": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            {
              "type": "null",
              "description": "MUST be null for substrate types (infrastructure_failure, tool_error). The orchestrator routes these to the substrate path; no repair-turn is injected."
            }
          ]
        },
        "session_id": {"type": "string"},
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "W3C trace-id, 16 bytes hex (32 chars)."
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "W3C span-id, 8 bytes hex (16 chars). The span_id of the breakdown.detect span."
        },
        "classifier": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "description": "URN-shaped: <vendor>.breakdown.<version>.<implementation>"
            },
            "version": {
              "type": "string",
              "description": "SemVer."
            }
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "remaining": {"type": "integer", "minimum": 0},
            "limit": {"type": "integer", "minimum": 1}
          },
          "description": "Cognitive types: required, with remaining. Substrate types: omit (substrate has its own per-type retry budget at orchestrator)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "drift",
                  "ambiguity",
                  "dead_loop",
                  "misalignment",
                  "context_collapse"
                ]
              }
            }
          },
          "then": {
            "required": ["repair_directive", "budget"],
            "properties": {
              "repair_directive": {"type": "object"},
              "budget": {
                "type": "object",
                "required": ["remaining"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["infrastructure_failure", "tool_error"]
              }
            }
          },
          "then": {
            "properties": {
              "repair_directive": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
