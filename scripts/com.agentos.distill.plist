<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentos.distill</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>'${HOME}/projects/agentos/scripts/distill-loop.sh'</string>
    </array>
    <key>WorkingDirectory</key>
    <string>'${HOME}/projects/agentos'</string>
    <key>RunAtLoad</key>
    <false/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>'${HOME}/.aos/logs/distill-launchd.stdout.log'</string>
    <key>StandardErrorPath</key>
    <string>'${HOME}/.aos/logs/distill-launchd.stderr.log'</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>${HOME}</string>
        <key>AOS_LINEAR_TEAM_ID</key>
        <string><your-linear-team-id></string>
        <key>AOS_LINEAR_TEAM_KEY</key>
        <string>RYA</string>
        <key>AOS_HOST</key>
        <string>localhost</string>
        <key>AOS_USER</key>
        <string>'${AOS_USER}'</string>
        <key>AOS_WORKSPACE_BASE</key>
        <string>'${HOME}/agent-workspaces'</string>
        <key>AOS_ORG_NAME</key>
        <string>'${AOS_ORG_NAME}'</string>
    </dict>
</dict>
</plist>
